rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function identified() {
      return request.auth != null && request.auth.token.email.lower() != 'demo@hotel.com';
    }
    function member() {
      return get(/databases/$(database)/documents/access_members/$(request.auth.uid)).data;
    }
    function permitted(roles) {
      return identified() && member().active == true && member().role in roles;
    }
    match /access_members/{uid} {
      allow get: if identified() && request.auth.uid == uid;
    }
    match /groups/{id} {
      function staff() { return permitted(['admin','direction','commercial']); }
      function managesAccounts() { return permitted(['admin','direction']); }
      function quote(data) {
        return data.get('Reserva', '') is string && data.get('Reserva', '').matches('(?i)^PRES-.*');
      }
      // Commercial staff can price drafts. A live receivable and its payment
      // history must be registered by management, accounting or the server.
      function financialFields() {
        return ['Reserva','Hotel_Asignado','Com_Total','Total','total','Importe(*)','Com_Pagado','PaymentPlan_JSON'];
      }
      allow read: if staff();
      allow create: if managesAccounts() || (staff() && quote(request.resource.data));
      allow update: if managesAccounts() || (staff() && (
        (quote(resource.data) && quote(request.resource.data)) ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(financialFields())));
      allow delete: if managesAccounts() || (staff() && quote(resource.data));
    }
    match /settings/{id} {
      allow read: if permitted(['admin','direction','commercial']) && id != 'users';
      allow write: if permitted(['admin','direction']) && id != 'users';
    }
  }
}
